{
  "entities": {
    "ResellerProfile": {
      "title": "ResellerProfile",
      "description": "Store configuration parameters for the hotspot reseller node",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the profile" },
        "business_name": { "type": "string", "description": "Reseller brand name" },
        "logo_emoji": { "type": "string", "description": "Chosen business representative emoji" },
        "logo_bg_color": { "type": "string", "description": "Brand aesthetic hex code color" },
        "phone": { "type": "string", "description": "Primary phone connection info" },
        "whatsapp_number": { "type": "string", "description": "WhatsApp dispatch line number" },
        "location": { "type": "string", "description": "Physical area coverage location" },
        "currency": { "type": "string", "description": "Aesthetic local currency representation" },
        "timezone": { "type": "string", "description": "Operational timezone designation" },
        "router_type": { "type": "string", "description": "Connected Starlink or standard router hardware" },
        "coverage_area": { "type": "string", "description": "Maximum reach metrics" },
        "bank_name": { "type": "string", "description": "Receiving bank name for offline tickets" },
        "bank_account_no": { "type": "string", "description": "Bank Account Number" },
        "bank_account_name": { "type": "string", "description": "Exact name on Bank account" },
        "payment_instructions": { "type": "string", "description": "Reseller payment terms and walkthroughs" },
        "whatsapp_provider": { "type": "string", "description": "Meta or Twilio service key designation" },
        "whatsapp_api_key": { "type": "string", "description": "Secret auth tokens for dispatching gateway messages" }
      },
      "required": ["id", "business_name", "phone", "whatsapp_number"]
    },
    "InternetPlan": {
      "title": "InternetPlan",
      "description": "Hotspot internet pass packages definition containing rates and durations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID for the internet pass" },
        "name": { "type": "string", "description": "Readable name of the internet plan" },
        "price": { "type": "number", "description": "Plan cost in local currency" },
        "data_limit_gb": { "type": "number", "description": "Maximum data volumes allowed in GB" },
        "duration_hours": { "type": "integer", "description": "Operational duration period in hours" },
        "speed_limit_mbps": { "type": "integer", "description": "Maximum download threshold in Mbps" },
        "device_limit": { "type": "integer", "description": "Allowed concurrent connected devices" },
        "validity_period_days": { "type": "integer", "description": "Total valid timeframe days" },
        "auto_expiry": { "type": "boolean", "description": "Will connection auto block upon period elapsed" },
        "description": { "type": "string", "description": "Short advertising text" },
        "is_active": { "type": "boolean", "description": "Ready to sell on consumer portals" },
        "is_popular": { "type": "boolean", "description": "Flag for popular layout highlighter card" }
      },
      "required": ["id", "name", "price", "duration_hours", "speed_limit_mbps"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Customer manual NGN bank transfer receipt ticket awaiting confirmation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ticket transaction ID" },
        "customer_name": { "type": "string", "description": "Declaring buyer name" },
        "customer_phone": { "type": "string", "description": "Reference phone interface" },
        "customer_email": { "type": "string", "description": "Buyer email for client portal access" },
        "plan_id": { "type": "string", "description": "Target purchase internet plan ID references" },
        "plan_name": { "type": "string", "description": "Literal plan name targeted" },
        "plan_price": { "type": "number", "description": "Purchased ticket monetary value" },
        "screenshot_url": { "type": "string", "description": "Uploaded image file or visual proof reference" },
        "reference": { "type": "string", "description": "Bank transfer reference description" },
        "status": { "type": "string", "description": "Approval progression status" },
        "timestamp": { "type": "string", "description": "Creation timestamp IsoString" },
        "whatsapp_delivered": { "type": "boolean", "description": "WhatsApp dispatcher status report" }
      },
      "required": ["id", "customer_name", "customer_phone", "plan_id", "status"]
    },
    "ActiveVoucher": {
      "title": "ActiveVoucher",
      "description": "Generated captive portal Wi-Fi access voucher with specific passcode keys",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Tracking ID" },
        "code": { "type": "string", "description": "Exact text key to type on the connection splash" },
        "plan_id": { "type": "string", "description": "Reference to parent internet packages" },
        "plan_name": { "type": "string", "description": "Plan name targeted" },
        "plan_price": { "type": "number", "description": "Monetary cost of voucher generated" },
        "status": { "type": "string", "description": "Active, used, or expired status code" },
        "date_created": { "type": "string", "description": "Generation date ticket IsoString" },
        "duration_hours": { "type": "integer", "description": "Voucher active operational timeframe hours" },
        "data_limit_gb": { "type": "number", "description": "Cap limit" },
        "remaining_data_gb": { "type": "number", "description": "Remaining metrics check" },
        "speed_limit_mbps": { "type": "integer", "description": "Allowed throughput metrics" },
        "customer_name": { "type": "string", "description": "Owner name of voucher" },
        "customer_phone": { "type": "string", "description": "Target phone number" },
        "customer_email": { "type": "string", "description": "Customer subscriber email key" },
        "is_multi_device": { "type": "boolean", "description": "Allow multiple devices connection" },
        "device_limit": { "type": "integer", "description": "Limit of concurrent networks" },
        "notes": { "type": "string", "description": "Custom administrative logs" }
      },
      "required": ["id", "code", "plan_id", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered hotspot subscribers database details and spending records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Customer unique tracking key" },
        "name": { "type": "string", "description": "Hotspot member name" },
        "phone": { "type": "string", "description": "Subscriber telephone route" },
        "whatsapp": { "type": "string", "description": "WhatsApp active numbers" },
        "active_plan_id": { "type": "string", "description": "Connected subscriber plans references" },
        "active_plan_name": { "type": "string", "description": "Name of currently active plan" },
        "expiry_time": { "type": "string", "description": "Calculated connection expiration date" },
        "total_spend": { "type": "number", "description": "Cumulative NGN paid to reseller" },
        "history_vouchers_count": { "type": "integer", "description": "Count of bought passes" },
        "is_suspended": { "type": "boolean", "description": "Is this subscriber currently blocked" },
        "is_blacklisted": { "type": "boolean", "description": "Is blacklisted from network coverage" },
        "notes": { "type": "string", "description": "Subscribers unique records" },
        "joined_date": { "type": "string", "description": "Signup timestamp IsoString" }
      },
      "required": ["id", "name", "phone"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "Real-time active device connected in the captive portal gateway",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session tracking ID" },
        "customer_name": { "type": "string", "description": "Active subscriber user name" },
        "ip_address": { "type": "string", "description": "Gateway leased IP address" },
        "mac_address": { "type": "string", "description": "Hardware physical MAC address string" },
        "device_type": { "type": "string", "description": "Leased device details" },
        "data_used_gb": { "type": "number", "description": "Used internet data volume metrics" },
        "upload_speed_mbps": { "type": "number", "description": "Upward bandwidth indicators" },
        "download_speed_mbps": { "type": "number", "description": "Downward bandwidth indicators" },
        "connected_duration": { "type": "string", "description": "Uptime duration format representation" },
        "voucher_code": { "type": "string", "description": "Leased passcode key used for entry" }
      },
      "required": ["id", "customer_name", "ip_address", "mac_address", "voucher_code"]
    },
    "WhatsAppMessageLog": {
      "title": "WhatsAppMessageLog",
      "description": "WhatsApp dispatch logs tracking messages with ticket passcodes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Dispatch record key ID" },
        "recipient_name": { "type": "string", "description": "Subscribers readable name" },
        "recipient_phone": { "type": "string", "description": "Subscriber destination telephone" },
        "message_type": { "type": "string", "description": "Log categories (approval, rejected, alerts)" },
        "content": { "type": "string", "description": "Body copy sent in text format" },
        "status": { "type": "string", "description": "Meta or API endpoint response messages" },
        "timestamp": { "type": "string", "description": "Recorded delivery timestamps" },
        "plan_name": { "type": "string", "description": "Plan detail metadata tags" },
        "voucher_code": { "type": "string", "description": "Passcodes sent in voucher payload" }
      },
      "required": ["id", "recipient_name", "recipient_phone", "content"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Generic application state configuration key value items",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Registry property title key" },
        "value": { "type": "string", "description": "Registry payload text" }
      },
      "required": ["key", "value"]
    }
  },
  "firestore": {
    "reseller_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/ResellerProfile" },
      "description": "Profile parameters mapping for reseller nodes"
    },
    "internet_plans/{planId}": {
      "schema": { "$ref": "#/entities/InternetPlan" },
      "description": "Available internet rate card plans options"
    },
    "payment_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "NGN payment tickets catalog verification requests pool"
    },
    "active_vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/ActiveVoucher" },
      "description": "Aesthetic active captive codes records collection"
    },
    "customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Subscribers accounts registered on the reseller splitter"
    },
    "active_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ActiveSession" },
      "description": "Active active lease devices sessions list"
    },
    "whatsapp_message_logs/{logId}": {
      "schema": { "$ref": "#/entities/WhatsAppMessageLog" },
      "description": "WhatsApp service dispatch alerts history logs"
    },
    "system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Generic global SaaS parameters mappings key list"
    }
  }
}
